{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markstore",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "cf3e5771c7b04b6a9f272cadacd9e61f"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "markstore-users",
      "database_id": "1d714f39-af05-41e4-a9e2-17f8e2a16e07"
    }
  ]
}
